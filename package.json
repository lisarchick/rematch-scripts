{
  "name": "rematch-scripts",
  "productName": "Rematch Scripts",
  "version": "1.0.2",
  "description": "Библиотека скриптов для Rematch",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build-index": "node scripts/build-index.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rematch.scripts",
    "productName": "Rematch Scripts",
    "files": ["src/**/*", "config.json", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "directories": { "output": "dist", "buildResources": "build" }
  }
}
